{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["retake"],
  "ios": {
    "iosModuleName": "NitroRetake"
  },
  "android": {
    "androidNamespace": ["retake"],
    "androidCxxLibName": "NitroRetake"
  },
  "autolinking": {
    "FrameScorer": {
      "android": { "language": "kotlin", "implementationClassName": "HybridFrameScorer" }
    },
    "UploadQueue": {
      "android": { "language": "kotlin", "implementationClassName": "HybridUploadQueue" }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
